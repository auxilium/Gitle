<h1>Dashboard</h1>
<ul class="tabs" data-tab data-options="deep_linking:true">
  <% if CurrentUser.IsAdmin: %>
  <li class="tab-title active"><a href="#progress-initial">Voortgang projecten</a></li>
  <% end %>
  <li class="tab-title <% if not CurrentUser.IsAdmin: %>active<% end %>"><a href="#progress-service">Voortgang serviceprojecten</a></li>
  <li class="tab-title"><a href="#service">Issue overzicht</a></li>
  <li class="tab-title"><a href="#issues">Voortgang per project</a></li>
</ul>
<div class="tabs-content">
  <% if CurrentUser.IsAdmin: %>
  <div class="content active" id="progress-initial" data-section="initial">
    <label><input type="checkbox" class="dashboard-closed" /> Toon gesloten projecten</label>
    <div class="dashboard-results"></div>
  </div>
  <% end %>
  <div class="content <% if not CurrentUser.IsAdmin: %>active<% end %>" id="progress-service" data-section="progress">
    <label><input type="checkbox" class="dashboard-closed" /> Toon gesloten projecten</label>
    <div class="dashboard-results"></div>
  </div>
  <div class="content" id="service" data-section="overview"><div class="dashboard-results"></div></div>
  <div class="content" id="issues" data-section="issues"><div class="dashboard-results"></div></div>
</div>
<script>
  $(function () {
    function loadPanel(panel) {
      if (!panel.length) return;
      var closed = panel.find('.dashboard-closed').is(':checked');
      var key = closed ? 'closed' : 'open';
      var cache = panel.data('dashboard-cache') || {};
      var results = panel.find('.dashboard-results');
      // Also cancel a closed-project request when returning to a cached open overview.
      var pending = panel.data('dashboard-request');
      if (pending && panel.data('dashboard-request-key') === key) return;
      if (pending) pending.abort();
      results.children().hide();
      results.find('.dashboard-status').remove();
      if (cache[key]) {
        cache[key].show();
        return;
      }
      var status = $('<p class="dashboard-status">Bezig met laden...</p>').appendTo(results);
      var request = $.get('/dashboard/section', { section: panel.data('section'), closed: closed });
      panel.data('dashboard-request', request);
      panel.data('dashboard-request-key', key);
      request.done(function (html) {
        status.remove();
        var content = $('<div></div>').appendTo(results);
        cache[key] = content;
        panel.data('dashboard-cache', cache);
        content.html(html);
        $(document).foundation('reflow');
      }).fail(function (_, state) {
        if (state === 'abort') return;
        status.text('Laden mislukt. ');
        $('<button type="button" class="button tiny">Opnieuw proberen</button>')
          .appendTo(status).click(function () { loadPanel(panel); });
      }).always(function () {
        if (panel.data('dashboard-request') === request) panel.removeData('dashboard-request');
      });
    }
    $('.tabs').on('toggled', function (_, tab) {
      var target = $(tab).find('a').addBack('a').attr('href');
      if (target) loadPanel($(target));
    });
    $('.tabs a').on('click', function () { loadPanel($($(this).attr('href'))); });
    $('.dashboard-closed').on('change', function () { loadPanel($(this).closest('[data-section]')); });
    $('#service').on('change', '#toggle-empties', function () {
      $('#service table.tickets-table').toggleClass('hide-empties', $(this).is(':checked'));
    }).on('change', '#toggle-overview-service-issues', function () {
      $('#service table.tickets-table').toggleClass('hide');
    });
    var hash = window.location.hash.replace('fndtn-', '');
    var panel = $('.tabs-content > .active').first();
    $('.tabs a').each(function () {
      if ($(this).attr('href') === hash) panel = $(hash);
    });
    loadPanel(panel);
  });
</script>
